# OPTIONAL. The production build already defaults to the deployed Render
# backend (https://marriage-prep-st-mary-catholic-church.onrender.com),
# so you do NOT need to set anything for GitHub Pages to work.
#
# Copy this to .env.local ONLY when you want the frontend to talk to a
# backend running on your own machine instead:
VITE_API_URL=http://localhost:4000

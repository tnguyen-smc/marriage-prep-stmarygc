# ============================================================
# For LOCAL development only (copy to .env and fill in).
#
# In production on Render, do NOT use this file — enter these
# same keys under your Render service's "Environment" tab.
# See README.md, "Configuring env without .env files".
# ============================================================

PORT=4000

# --- Values already set for this deployment ----------------

# The GitHub Pages site that talks to this backend.
# Used for CORS, for the post-login redirect, and to build the
# couple-profile links inside Google Calendar invitations.
CLIENT_URL=https://tnguyen-smc.github.io/marriage-prep-stmarygc

# Must exactly match an Authorized redirect URI on your OAuth
# client in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://marriage-prep-st-mary-catholic-church-d3d8.onrender.com/api/auth/google/callback

# Frontend and backend are on different domains (github.io vs
# onrender.com), so the session cookie MUST be cross-site.
# Both of these are required, and both sides must be HTTPS.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- Values you must fill in yourself ----------------------

# Any long random string (signs the session cookie).
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# From the Drive folder's URL:
# https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
GOOGLE_DRIVE_FOLDER_ID=

# The single Google account with full admin access (Settings,
# templates, priest roster).
ADMIN_EMAIL=
